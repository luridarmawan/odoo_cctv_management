<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- CCTV User -->
        <record id="cctv_user_group" model="res.groups">
            <field name="name">CCTV User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- CCTV Supervisor -->
        <record id="cctv_supervisor_group" model="res.groups">
            <field name="name">CCTV Supervisor</field>
            <field name="implied_ids" eval="[(4, ref('cctv_management.cctv_user_group'))]"/>
        </record>

        <!-- CCTV Administrator -->
        <record id="cctv_administrator_group" model="res.groups">
            <field name="name">CCTV Administrator</field>
            <field name="implied_ids" eval="[(4, ref('cctv_management.cctv_supervisor_group'))]"/>
        </record>
        <!-- Auto-assign Administrator to CCTV Administrator group -->
        <record id="base.user_admin" model="res.users">
            <field name="groups_id" eval="[(4, ref('cctv_management.cctv_administrator_group'))]"/>
        </record>
    </data>
</odoo>
